<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<AnchorPane prefHeight="600.0" prefWidth="820.0" stylesheets="stylesheets/rentamovie.css" xmlns="http://javafx.com/javafx/8.0.40"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.zettsystems.rentamovie.movie.adapter.MovieOverviewController">
    <children>
        <SplitPane dividerPositions="0.45" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minWidth="0.0">
                    <children>
                        <TextField fx:id="searchInput" promptText="Search movies" AnchorPane.leftAnchor="12.0"
                                   AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0"/>
                        <TableView fx:id="movieTable" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0"
                                   AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="48.0">
                            <columns>
                                <TableColumn fx:id="yearOfPublicationColumn" prefWidth="90.0" text="Year of pub."/>
                                <TableColumn fx:id="titleColumn" prefWidth="160.0" text="Title"/>
                                <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Status"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </AnchorPane>
                <AnchorPane minWidth="0.0" styleClass="detail-pane">
                    <children>
                        <Label styleClass="header-label" text="Movie Details" AnchorPane.leftAnchor="16.0"
                               AnchorPane.topAnchor="16.0"/>
                        <GridPane hgap="12.0" vgap="10.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0"
                                  AnchorPane.topAnchor="56.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="90.0"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints/>
                                <RowConstraints/>
                                <RowConstraints/>
                                <RowConstraints/>
                                <RowConstraints/>
                            </rowConstraints>
                            <children>
                                <Label text="Year of pub."/>
                                <Label text="Title" GridPane.rowIndex="1"/>
                                <Label text="Copies" GridPane.rowIndex="2"/>
                                <Label text="Status" GridPane.rowIndex="3"/>
                                <Label text="Copy format" GridPane.rowIndex="4"/>
                                <TextField fx:id="yearOfPublicationInput" GridPane.columnIndex="1"/>
                                <TextField fx:id="titleInput" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label fx:id="copiesLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="statusInput" maxWidth="Infinity" GridPane.columnIndex="1"
                                          GridPane.rowIndex="3"/>
                                <ComboBox fx:id="mediaFormatInput" maxWidth="Infinity" GridPane.columnIndex="1"
                                          GridPane.rowIndex="4"/>
                            </children>
                        </GridPane>
                        <ButtonBar AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0"
                                   AnchorPane.rightAnchor="16.0">
                            <buttons>
                                <Button fx:id="previousPageButton" mnemonicParsing="false"
                                        onAction="#handlePreviousPage" text="Prev"/>
                                <Label fx:id="pageInfoLabel" text="1 / 1"/>
                                <Button fx:id="nextPageButton" mnemonicParsing="false" onAction="#handleNextPage"
                                        text="Next"/>
                                <Button fx:id="newButton" mnemonicParsing="false" onAction="#handleNewMovie"
                                        text="New"/>
                                <Button fx:id="copyButton" mnemonicParsing="false" onAction="#handleCopies"
                                        text="Add copy"/>
                                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveMovie"
                                        text="Save"/>
                            </buttons>
                        </ButtonBar>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
