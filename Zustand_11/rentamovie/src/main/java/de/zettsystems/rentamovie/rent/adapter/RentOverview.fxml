<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<AnchorPane prefHeight="600.0" prefWidth="820.0" stylesheets="stylesheets/rentamovie.css" xmlns="http://javafx.com/javafx/8.0.40"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.zettsystems.rentamovie.rent.adapter.RentOverviewController">
    <children>
        <Label styleClass="header-label" text="Rents" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="16.0"/>
        <ComboBox fx:id="statusFilterBox" prefWidth="150.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0"/>
        <HBox alignment="CENTER_LEFT" spacing="8.0" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="52.0">
            <Label text="Worklists:"/>
            <Button mnemonicParsing="false" onAction="#handleAllWorklist" text="All"/>
            <Button mnemonicParsing="false" onAction="#handleOpenRentsWorklist" text="Open"/>
            <Button mnemonicParsing="false" onAction="#handleOverdueWorklist" text="Overdue"/>
            <Button mnemonicParsing="false" onAction="#handleOpenPaymentsWorklist" text="Open pay"/>
            <Button mnemonicParsing="false" onAction="#handlePaidWorklist" text="Paid"/>
        </HBox>
        <TableView fx:id="rentTable" AnchorPane.bottomAnchor="64.0" AnchorPane.leftAnchor="16.0"
                   AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="92.0">
            <columns>
                <TableColumn fx:id="customerColumn" prefWidth="110.0" text="Customer"/>
                <TableColumn fx:id="copyColumn" prefWidth="160.0" text="Copy"/>
                <TableColumn fx:id="startDateColumn" prefWidth="100.0" text="Start Date"/>
                <TableColumn fx:id="plannedReturnDateColumn" prefWidth="110.0" text="Planned Return"/>
                <TableColumn fx:id="endDateColumn" prefWidth="100.0" text="End Date"/>
                <TableColumn fx:id="paymentStatusColumn" prefWidth="100.0" text="Payment"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <ButtonBar AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0">
            <buttons>
                <Button fx:id="previousPageButton" mnemonicParsing="false" onAction="#handlePreviousPage" text="Prev"/>
                <Label fx:id="pageInfoLabel" text="1 / 1"/>
                <Button fx:id="nextPageButton" mnemonicParsing="false" onAction="#handleNextPage" text="Next"/>
                <Button fx:id="dailyClosingButton" mnemonicParsing="false" onAction="#handleDailyClosing"
                        text="Daily closing"/>
                <Button fx:id="newButton" mnemonicParsing="false" onAction="#handleNewRent" text="New"/>
                <Button fx:id="returnButton" mnemonicParsing="false" onAction="#handleReturnRent" text="Return"/>
                <Button fx:id="payButton" mnemonicParsing="false" onAction="#handlePayRent" text="Pay"/>
            </buttons>
        </ButtonBar>
    </children>
</AnchorPane>
